generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id                       String    @id @default(uuid())
  name                     String
  slug                     String    @unique
  plan                     Plan      @default(FREE)
  paystackRef              String?
  paystackSubscriptionCode String?   @unique
  paystackCustomerCode     String?
  subscriptionStatus       SubscriptionStatus @default(NONE)
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  members     Member[]
  tasks       Task[]
  invites     Invite[]
  auditLogs   AuditLog[]
  billing     Billing[]
  featureFlagOverrides OrganisationFeatureFlag[]
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  resetTokenHash    String?
  resetTokenExpiry  DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members      Member[]
  assignedTasks Task[]  @relation("AssignedTo")
  createdTasks  Task[]  @relation("CreatedBy")
  approvals     Approval[]
  refreshTokens RefreshToken[]
}

model Member {
  id             String       @id @default(uuid())
  role           MemberRole   @default(MEMBER)
  joinedAt       DateTime     @default(now())
  deletedAt      DateTime?

  userId         String
  organisationId String

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
}

model Invite {
  id             String       @id @default(uuid())
  email          String
  tokenHash      String       @unique
  role           MemberRole   @default(MEMBER)
  expiresAt      DateTime
  acceptedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model Task {
  id             String     @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus @default(PENDING)
  requiresApproval Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organisationId String
  createdById    String
  assignedToId   String?

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo     User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  approvals      Approval[]
}

model Approval {
  id        String         @id @default(uuid())
  status    ApprovalStatus @default(PENDING)
  note      String?
  createdAt DateTime       @default(now())

  taskId    String
  userId    String

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id])
}

model Billing {
  id              String        @id @default(uuid())
  paystackRef     String?       @unique
  paystackEvent   String?
  amount          Int
  currency        String        @default("NGN")
  status          BillingStatus @default(PENDING)
  plan            Plan
  createdAt       DateTime      @default(now())

  organisationId  String
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

// Append-only audit log — application enforces no updates or deletes
// DB role for app user should have INSERT only on this table
model AuditLog {
  id             String   @id @default(uuid())
  action         String
  resource       String
  resourceId     String?
  actorId        String?
  actorEmail     String?
  metadata       Json?
  ipAddress      String?
  hash           String   // SHA-256 of (previousHash + action + timestamp)
  previousHash   String?
  createdAt      DateTime @default(now())

  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  DONE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  DISABLED
}

// Global flags — the platform-wide default. Managed via
// scripts/manage-feature-flags.js, not an HTTP API (no platform-level
// admin auth exists yet, only org-scoped admins — see OrganisationFeatureFlag
// below for the tenant-facing side).
model FeatureFlag {
  key         String    @id
  description String?
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organisationOverrides OrganisationFeatureFlag[]
}

// Per-org override of a flag's global default. Presence of a row means
// "this org has an explicit setting"; absence means "fall back to
// FeatureFlag.enabled". Managed by org admins for their own org only.
model OrganisationFeatureFlag {
  id             String   @id @default(uuid())
  organisationId String
  flagKey        String
  enabled        Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  flag         FeatureFlag  @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([organisationId, flagKey])
}
