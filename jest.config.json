{
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/jest.setup.js"],
  "testMatch": ["**/__tests__/**/*.test.js"],
  "collectCoverageFrom": ["src/**/*.js", "!src/index.js"],
  "coverageThreshold": {
    "global": { "lines": 30 },
    "./src/controllers/auth.js": { "lines": 45 },
    "./src/middleware/": { "lines": 45 }
  }
}
